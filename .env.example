# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-stream-api-token
# Customer subdomain code shown on the Stream dashboard — used to build
# playback URLs (customer-<code>.cloudflarestream.com). Public: rendered
# directly into iframe src on the page.
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=your-stream-customer-code
CLOUDFLARE_R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=your-cloudflare-r2-bucket-name
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Signs requests to POST /api/webhooks/cloudflare-stream. Issued when you
# register the webhook notification URL — see that route's file comment
# for the one-time setup command; can't be registered until the app has
# a real public URL (not localhost).
CLOUDFLARE_STREAM_WEBHOOK_SECRET=your-cloudflare-stream-webhook-secret

# ML service (nia-football-ml)
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your-ml-api-key
